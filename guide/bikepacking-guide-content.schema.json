{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gravelgodcycling.com/schemas/bikepacking-guide-content.schema.json",
  "title": "Gravel God Bikepacking Guide Content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "subtitle",
    "meta_description",
    "personalization",
    "glossary",
    "chapters"
  ],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string", "minLength": 1},
    "meta_description": {"type": "string", "minLength": 50, "maxLength": 180},
    "personalization": {
      "type": "object",
      "required": ["rider_types", "storage_key"],
      "properties": {
        "rider_types": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "label", "hours", "default_ftp"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "label": {"type": "string", "minLength": 1},
              "hours": {"type": "string", "minLength": 1},
              "default_ftp": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        },
        "storage_key": {"type": "string", "pattern": "^gg_bikepacking_guide_"}
      },
      "additionalProperties": false
    },
    "glossary": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "chapters": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/chapter"}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["claim", "source"],
      "properties": {
        "claim": {"type": "string", "minLength": 12},
        "source": {
          "type": "string",
          "pattern": "^(Ultra Bikepacking Training White Paper §.+ \\[(verified|principle|position)\\](, \\[(verified|principle|position)\\])*|Ultra Method Contract v2\\.6 §.+|race-data/[a-z0-9-]+\\.json(; race-data/[a-z0-9-]+\\.json)*)$"
        }
      },
      "additionalProperties": false
    },
    "textItem": {
      "type": "object",
      "required": ["content"],
      "properties": {"content": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "prose",
            "callout",
            "process_list",
            "accordion",
            "personalized_content",
            "data_table",
            "timeline",
            "knowledge_check"
          ]
        },
        "content": {"type": "string", "minLength": 1},
        "style": {"type": "string", "minLength": 1},
        "items": {"type": "array", "minItems": 1},
        "variants": {"type": "object"},
        "caption": {"type": "string", "minLength": 1},
        "headers": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "title": {"type": "string", "minLength": 1},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["label", "content"],
            "properties": {
              "label": {"type": "string", "minLength": 1},
              "content": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "question": {"type": "string", "minLength": 1},
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["text", "correct"],
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "correct": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        },
        "explanation": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "prose"}}},
          "then": {"required": ["content"]}
        },
        {
          "if": {"properties": {"type": {"const": "callout"}}},
          "then": {"required": ["style", "content"]}
        },
        {
          "if": {"properties": {"type": {"const": "process_list"}}},
          "then": {
            "properties": {
              "items": {
                "items": {
                  "type": "object",
                  "required": ["label", "detail", "percentage"],
                  "properties": {
                    "label": {"type": "string", "minLength": 1},
                    "detail": {"type": "string", "minLength": 1},
                    "percentage": {"type": "integer", "minimum": 0, "maximum": 100}
                  },
                  "additionalProperties": false
                }
              }
            },
            "required": ["items"]
          }
        },
        {
          "if": {"properties": {"type": {"const": "accordion"}}},
          "then": {
            "properties": {
              "items": {
                "items": {
                  "type": "object",
                  "required": ["title", "content"],
                  "properties": {
                    "title": {"type": "string", "minLength": 1},
                    "content": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": false
                }
              }
            },
            "required": ["items"]
          }
        },
        {
          "if": {"properties": {"type": {"const": "personalized_content"}}},
          "then": {
            "properties": {
              "variants": {
                "required": ["ayahuasca", "finisher", "competitor", "podium"],
                "properties": {
                  "ayahuasca": {"$ref": "#/$defs/textItem"},
                  "finisher": {"$ref": "#/$defs/textItem"},
                  "competitor": {"$ref": "#/$defs/textItem"},
                  "podium": {"$ref": "#/$defs/textItem"}
                },
                "additionalProperties": false
              }
            },
            "required": ["variants"]
          }
        },
        {
          "if": {"properties": {"type": {"const": "data_table"}}},
          "then": {"required": ["caption", "headers", "rows"]}
        },
        {
          "if": {"properties": {"type": {"const": "timeline"}}},
          "then": {"required": ["title", "steps"]}
        },
        {
          "if": {"properties": {"type": {"const": "knowledge_check"}}},
          "then": {"required": ["question", "options", "explanation"]}
        }
      ],
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": ["id", "title", "blocks"],
      "properties": {
        "id": {"type": "string", "pattern": "^ch[1-8]-[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/block"}
        }
      },
      "additionalProperties": false
    },
    "chapter": {
      "type": "object",
      "required": [
        "number",
        "id",
        "title",
        "subtitle",
        "gated",
        "cta_after",
        "sections",
        "sources"
      ],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 8},
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string", "minLength": 1},
        "gated": {"type": "boolean"},
        "cta_after": {
          "type": ["string", "null"],
          "enum": [null, "ultra_shelf", "coaching_corner", "finale"]
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/section"}
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        }
      },
      "additionalProperties": false
    }
  }
}
